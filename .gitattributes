# Normalize line endings: store text as LF in the repo, check out native on Windows.
* text=auto

# Keep these LF even on Windows checkout (scripts / web assets).
*.js   text eol=lf
*.mjs  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.gs   text eol=lf

# Binary — never touch.
*.xlsx binary
*.png  binary
*.jpg  binary
*.ico  binary
