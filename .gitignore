# Dependencies (none committed; app loads React/GIS from CDN, tests use Node built-ins)
node_modules/

# Logs / debug
npm-debug.log*
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Build / temp output
dist/
build/
tmp/
*.tmp

# Local env overrides (config.js IS committed on purpose — the OAuth Client ID is public;
# put anything genuinely secret in a git-ignored file instead)
.env
.env.local
config.local.js

# Vercel CLI local state (project link / build cache)
.vercel/

# Supabase local state — holds project_id / secrets; migrations & tests ARE committed (see supabase/README.md)
supabase/config.toml
supabase/.branches/
supabase/.temp/
.supabase/
